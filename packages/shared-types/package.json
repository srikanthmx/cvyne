{
  "name": "shared-types",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api.gen.ts"
  },
  "scripts": {
    "generate": "openapi-typescript http://localhost:8000/openapi.json -o ./src/api.gen.ts && echo '✓ Types regenerated from FastAPI'",
